# Supabase configuration for Lucine Store.
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings -> API). The anon key is safe for the browser because all
# access is governed by Row Level Security — see `supabase/schema.sql`.
#
# When both values are present the app reads and writes every catalog record
# (products, categories, promotions, orders) through Supabase. When they are
# empty the app falls back to the local seed data so it keeps working offline.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute, public URL of the deployed site, WITH a trailing slash.
# Used for canonical URLs, hreflang, Open Graph tags, the sitemap and robots.txt.
# Leave empty to derive it from the request at runtime (handy locally), but set
# it in production so crawlers always see the same canonical host.
# Example: https://lucinestore.com/
VITE_SITE_URL=
